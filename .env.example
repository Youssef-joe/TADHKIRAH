# --- Local development (pnpm dev). Copy to .env; the API loads it automatically. ---
DATABASE_URL=postgres://tadhkirah:tadhkirah@localhost:5432/tadhkirah
WEB_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# Any random string of 32+ characters (openssl rand -base64 48)
AUTH_SECRET=change-me-change-me-change-me-change-me
# Reflection encryption key for local dev (generate your own: openssl rand -base64 32)
MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcy1vayE=
# Mailpit from `pnpm infra:up` catches every email: http://localhost:8025
SMTP_URL=smtp://localhost:1025
LOG_LEVEL=debug
# The address Next.js uses to reach the API
API_INTERNAL_URL=http://localhost:4000

# --- Production (Coolify Environment tab) — required ---
# POSTGRES_PASSWORD=<long random string>
# PUBLIC_WEB_URL=https://your-domain.example
# AUTH_SECRET=<openssl rand -base64 48>
# MASTER_KEY=<openssl rand -base64 32>   <- keep an offline copy; losing it makes reflections unreadable
# SMTP_URL=smtp://user:password@smtp.provider.example:587
# MAIL_FROM=Tadhkirah <no-reply@your-domain.example>
