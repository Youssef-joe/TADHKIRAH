# Local-only values for running the production images over http. Never use in production.
# docker compose --env-file infra/local.env -f docker-compose.yml -f infra/compose.local.yml up --build
POSTGRES_PASSWORD=local
PUBLIC_WEB_URL=http://localhost:3000
AUTH_SECRET=local-only-secret-local-only-secret-local
SMTP_URL=smtp://mailpit:1025
ALLOW_INSECURE_HTTP=true
